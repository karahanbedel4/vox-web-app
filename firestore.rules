rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection (Allows read/write for authenticated users, owners, and guest sessions)
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Articles collection (Publicly readable, writeable by authenticated/guest users)
    match /articles/{articleId} {
      allow read, write, delete: if true;
    }

    // User history
    match /user_history/{historyId} {
      allow read, write, delete: if true;
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read, write, delete: if true;
    }

    // Listening logs for streak calculation
    match /listening_logs/{logId} {
      allow read, write, delete: if true;
    }
  }
}
